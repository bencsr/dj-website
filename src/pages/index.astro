---
const name = "DJ Bencs";
const email = "bencsrr@gmail.com";
const phone = "+36-30/548-1026";
const phoneHref = "+36305481026";
const facebook = "https://www.facebook.com/bencsr/";
const youtube = "https://www.youtube.com/@bencsr";
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{name} | DJ szolgáltatás rendezvényekre</title>
    <meta
      name="description"
      content="DJ szolgáltatás esküvőkre, céges rendezvényekre, születésnapokra és privát eseményekre."
    />
  </head>

  <body>
    <main class="page">
      <section class="hero">
		<h1>
		 Hangulat.<br /> 
		 Ritmus.<br />
         Precíz szervezés.
		</h1>

		<p class="lead">
		DJ szolgáltatás és hangosítás rendezvényekhez —	a háttérzenétől a telt tánctérig.
		</p>
      </section>

      <section class="content">
        <div class="services">
          <h2>Szolgáltatások</h2>

          <div class="service-list">
            <article class="service-card">
              <h3>DJ szolgáltatás</h3>
              <p>
                Céges rendezvények, esküvők, bálok és privát bulik zenei
                lebonyolítása. A cél mindig az, hogy az esemény hangulatához,
                közönségéhez és menetéhez illeszkedjen a zene.
              </p>
            </article>

            <article class="service-card">
              <h3>Rendezvények hangosítása</h3>
              <p>
                Hangosítás kisebb és közepes rendezvényekhez, például
                táncversenyekhez, sportnapokhoz, beszédekhez és háttérzenés
                eseményekhez.
              </p>
            </article>

            <article class="service-card">
              <h3>Zenei összeállítások készítése</h3>
              <p>
                Egyedi mixek, vágott zenei alapok és összeállítások
                fellépésekhez, műsorokhoz, bevonulásokhoz vagy különleges
                produkciókhoz.
              </p>
            </article>
          </div>
        </div>

        <div>
          <h2>Kapcsolat</h2>
          <ul class="contact">
            <li>
              <a class="contact-link" href={`mailto:${email}`} aria-label={`Email: ${email}`}>
                <span class="contact-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M4 6h16v12H4z" stroke="currentColor" stroke-width="1.8"></path>
                    <path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.8"></path>
                  </svg>
                </span>
                <span>{email}</span>
              </a>
            </li>
            <li>
              <a class="contact-link" href={`tel:${phoneHref}`} aria-label={`Telefon: ${phone}`}>
                <span class="contact-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.35 1.9.68 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.28-1.28a2 2 0 0 1 2.11-.45c.9.33 1.84.55 2.8.68A2 2 0 0 1 22 16.92z" stroke="currentColor" stroke-width="1.8"></path>
                  </svg>
                </span>
                <span>{phone}</span>
              </a>
            </li>
            <li>
              <a class="contact-link" href={facebook} target="_blank" rel="noopener" aria-label="Facebook oldal">
                <span class="contact-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24">
                    <path d="M15.12 5.32h2.1V2.14A27 27 0 0 0 14.16 2c-3.03 0-5.1 1.85-5.1 5.25v2.93H5.64v3.56h3.42V22h4.09v-8.26h3.4l.54-3.56h-3.94V7.6c0-1.03.29-2.28 1.97-2.28z" fill="currentColor"></path>
                  </svg>
                </span>
                <span>facebook.com/bencsr</span>
              </a>
            </li>
            <li>
              <a class="contact-link" href={youtube} target="_blank" rel="noopener" aria-label="YouTube csatorna">
                <span class="contact-icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24">
                    <path d="M23.5 6.2a3 3 0 0 0-2.1-2.13C19.55 3.56 12 3.56 12 3.56s-7.55 0-9.4.51A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.13c1.85.51 9.4.51 9.4.51s7.55 0 9.4-.51a3 3 0 0 0 2.1-2.13A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8z" fill="currentColor"></path>
                    <path d="M9.6 15.55v-7.1L15.85 12z" fill="#fff"></path>
                  </svg>
                </span>
                <span>youtube.com/@bencsr</span>
              </a>
            </li>
          </ul>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    --color-deep-blue: #123a63;

    color: #111;
    background: #fff;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #fff;
    color: #111;
  }

  a {
    color: inherit;
  }

  .page {
    width: min(100% - 32px, 960px);
    margin: 0 auto;
    padding: 16px 0 56px;
  }

  .hero {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 16px 0 36px;
    border-bottom: 1px solid #eaeaea;
  }

  .eyebrow {
    margin: 0 0 20px;
    color: #666;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--color-deep-blue);
    font-size: clamp(2.25rem, 5.5vw, 4.25rem);
    line-height: 0.92;
    letter-spacing: -0.07em;
  }

  .lead {
    margin: 28px 0 0;
    font-size: clamp(1rem, 2vw, 1.3rem);
    line-height: 1.45;
    color: #333;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 160ms ease,
      background 160ms ease,
      border-color 160ms ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .primary {
    background: #111;
    color: #fff;
  }

  .secondary {
    border: 1px solid #d8d8d8;
    color: #111;
  }

  .secondary:hover {
    border-color: #111;
  }

  .content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    padding: 36px 0 24px;
  }

  h2 {
    margin: 0 0 16px;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .content p {
    margin: 0;
    color: #444;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .services {
    display: grid;
    gap: 0;
  }

  .service-list {
    display: grid;
    gap: 16px;
  }

  .service-card {
    padding: 22px;
    border: 1px solid #eaeaea;
    border-radius: 24px;
    background: #fff;
  }

  .service-card h3 {
    margin: 0 0 10px;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .contact {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
  }

  .contact li {
    margin: 0;
  }

  .contact-link {
    display: inline-grid;
    grid-template-columns: 32px minmax(0, auto);
    align-items: center;
    gap: 12px;
    min-height: 32px;
    font-size: 1.05rem;
    line-height: 1.2;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: color 160ms ease;
  }

  .contact-link:hover,
  .contact-link:focus-visible {
    color: var(--color-deep-blue);
  }

  .contact-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 32px;
    height: 32px;
    border: 1px solid #e4e4e4;
    border-radius: 50%;
    color: #666;
    transition:
      border-color 160ms ease,
      color 160ms ease;
  }

  .contact-link:hover .contact-icon,
  .contact-link:focus-visible .contact-icon {
    border-color: var(--color-deep-blue);
    color: var(--color-deep-blue);
  }

  .contact-icon svg {
    display: block;
    flex: 0 0 auto;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 720px) {
    .page {
      width: min(100% - 24px, 960px);
      padding: 12px 0 40px;
    }

    .hero {
      padding: 12px 0 32px;
    }

    .content {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-top: 32px;
    }

    .button {
      width: 100%;
    }
  }
</style>
