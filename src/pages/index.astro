---
const name = "DJ Bencs";
const email = "bencsrr@gmail.com";
const phone = "+36-30/548-1026";
const phoneHref = "+36305481026";
const messenger = "https://www.messenger.com/t/bencsr";
const youtube = "https://www.youtube.com/@bencsr";

const youtubeMixes = [
  { title: "A 90-es évek legjobb magyar zenéi", url: "https://www.youtube.com/watch?v=6Fjo4M2vSdc" },
  { title: "Winter Melodic Journey", url: "https://www.youtube.com/watch?v=SK69dqVc88w" },
  { title: "70s 80s 90s CLASSIC HITS REBORN", url: "https://www.youtube.com/watch?v=Ooj35_IA9iA" },
];

const getYouTubeId = (url: string) => {
  if (!url) return "";

  try {
    const parsedUrl = new URL(url);

    if (parsedUrl.hostname.includes("youtu.be")) {
      return parsedUrl.pathname.replace("/", "");
    }

    if (parsedUrl.pathname.includes("/embed/")) {
      return parsedUrl.pathname.split("/embed/")[1]?.split("/")[0] ?? "";
    }

    if (parsedUrl.pathname.includes("/shorts/")) {
      return parsedUrl.pathname.split("/shorts/")[1]?.split("/")[0] ?? "";
    }

    return parsedUrl.searchParams.get("v") ?? "";
  } catch {
    return url;
  }
};

const mixes = youtubeMixes
  .map((mix) => ({ ...mix, id: getYouTubeId(mix.url) }))
  .filter((mix) => mix.id);
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>DJ Miskolc | Esküvői és rendezvény DJ – {name}</title>
    <meta
      name="description"
      content="DJ szolgáltatás és rendezvényhangosítás Miskolcon és környékén, esküvőkre, céges rendezvényekre, bálokra és privát eseményekre. Kérj ajánlatot!"
    />
  </head>

  <body>
    <main class="page">
      <section class="hero">
        <h1>DJ és rendezvényhangosítás Miskolcon</h1>

        <p class="lead">
          Esküvők, céges rendezvények, bálok és privát bulik zenei
          lebonyolítása Miskolcon és a környéken — a háttérzenétől a telt
          tánctérig.
        </p>
      </section>

      <section class="content">
        <div class="services">
          <h2>Szolgáltatások</h2>

          <div class="service-list">
            <article class="service-card">
              <h3>DJ szolgáltatás</h3>
              <p>
                Céges rendezvények, esküvők, bálok és privát bulik zenei
                lebonyolítása. A cél mindig az, hogy az esemény hangulatához,
                közönségéhez és menetéhez illeszkedjen a zene.
              </p>
            </article>

            <article class="service-card">
              <h3>Rendezvények hangosítása</h3>
              <p>
                Hangosítás kisebb és közepes rendezvényekhez, például
                táncversenyekhez, sportnapokhoz, beszédekhez és háttérzenés
                eseményekhez.
              </p>
            </article>

            <article class="service-card">
              <h3>Zenei összeállítások készítése</h3>
              <p>
                Egyedi mixek, vágott zenei alapok és összeállítások
                fellépésekhez, műsorokhoz, bevonulásokhoz vagy különleges
                produkciókhoz.
              </p>
            </article>
          </div>
        </div>

        <div>
          <h2>Kapcsolat</h2>
          <ul class="contact">
            <li>
              <a class="contact-link" href={`mailto:${email}`} aria-label={`Email: ${email}`}>
                <span class="contact-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M4 6h16v12H4z" stroke="currentColor" stroke-width="1.8"></path>
                    <path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.8"></path>
                  </svg>
                </span>
                <span>{email}</span>
              </a>
            </li>
            <li>
              <a class="contact-link" href={`tel:${phoneHref}`} aria-label={`Telefon: ${phone}`}>
                <span class="contact-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.35 1.9.68 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.28-1.28a2 2 0 0 1 2.11-.45c.9.33 1.84.55 2.8.68A2 2 0 0 1 22 16.92z" stroke="currentColor" stroke-width="1.8"></path>
                  </svg>
                </span>
                <span>{phone}</span>
              </a>
            </li>
            <li>
              <a class="contact-link" href={messenger} target="_blank" rel="noopener" aria-label="Messenger üzenet">
                <span class="contact-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9H13a8.48 8.48 0 0 1 8 8v.5z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
                    <path d="m8.5 12.5 2.4-2.4 2.3 2.3 2.3-2.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </span>
                <span>messenger.com/t/bencsr</span>
              </a>
            </li>
            <li>
              <a class="contact-link" href={youtube} target="_blank" rel="noopener" aria-label="YouTube csatorna">
                <span class="contact-icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24">
                    <path d="M23.5 6.2a3 3 0 0 0-2.1-2.13C19.55 3.56 12 3.56 12 3.56s-7.55 0-9.4.51A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.13c1.85.51 9.4.51 9.4.51s7.55 0 9.4-.51a3 3 0 0 0 2.1-2.13A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8z" fill="currentColor"></path>
                    <path d="M9.6 15.55v-7.1L15.85 12z" fill="#fff"></path>
                  </svg>
                </span>
                <span>youtube.com/@bencsr</span>
              </a>
            </li>
            <li>
              <span class="contact-item" aria-label="Helyszín: Miskolc">
                <span class="contact-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M12 21s7-6.1 7-12a7 7 0 0 0-14 0c0 5.9 7 12 7 12z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
                    <circle cx="12" cy="9" r="2.4" stroke="currentColor" stroke-width="1.8"></circle>
                  </svg>
                </span>
                <span>Miskolc</span>
              </span>
            </li>
          </ul>
        </div>
      </section>

      <section class="service-area" aria-labelledby="service-area-title">
        <h2 id="service-area-title">Szolgáltatási terület</h2>
        <p>
          Elsősorban Miskolcon és környékén, a várostól nagyjából 1,5 órás autóúton
          belül vállalok rendezvényeket. Szívesen dolgozom többek között
          Kazincbarcikán, Ózdon, Tiszaújvárosban, Mezőkövesden, Egerben, Debrecenben, Nyíeregyházán,
          Szerencsen, Tokajban, Sárospatakon és a környező településeken. 
          Egyedi megbeszélés alapján távolabbi helyszínek sem jelentenek akadályt.
        </p>
      </section>

      {
        mixes.length > 0 && (
          <section class="mixes" aria-labelledby="mixes-title">
            <h2 id="mixes-title">Mixek</h2>

            <div class="mix-list">
              {mixes.map((mix) => (
                <article class="mix-card">
                  <iframe
                    src={`https://www.youtube-nocookie.com/embed/${mix.id}`}
                    title={`${mix.title} YouTube lejátszó`}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                  />
                </article>
              ))}
            </div>
          </section>
        )
      }
    </main>
  </body>
</html>

<style>
  :root {
    --color-deep-blue: #123a63;

    color: #111;
    background: #fff;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #fff;
    color: #111;
  }

  a {
    color: inherit;
  }

  .page {
    width: min(100% - 32px, 960px);
    margin: 0 auto;
    padding: 16px 0 56px;
  }

  .hero {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 16px 0 36px;
    border-bottom: 1px solid #eaeaea;
  }

  .eyebrow {
    margin: 0 0 20px;
    color: #666;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--color-deep-blue);
    font-size: clamp(2.25rem, 5.5vw, 4.25rem);
    line-height: 0.92;
    letter-spacing: -0.07em;
  }

  .lead {
    margin: 28px 0 0;
    font-size: clamp(1rem, 2vw, 1.3rem);
    line-height: 1.45;
    color: #333;
  }

  .tagline {
    margin: 22px 0 0;
    color: var(--color-deep-blue);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 160ms ease,
      background 160ms ease,
      border-color 160ms ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .primary {
    background: #111;
    color: #fff;
  }

  .secondary {
    border: 1px solid #d8d8d8;
    color: #111;
  }

  .secondary:hover {
    border-color: #111;
  }

  .content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    padding: 36px 0 24px;
  }

  h2 {
    margin: 0 0 16px;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .content p {
    margin: 0;
    color: #444;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .services {
    display: grid;
    gap: 0;
  }

  .service-list {
    display: grid;
    gap: 16px;
  }

  .service-card {
    padding: 22px;
    border: 1px solid #eaeaea;
    border-radius: 24px;
    background: #fff;
  }

  .service-card h3 {
    margin: 0 0 10px;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .contact {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
  }

  .contact li {
    margin: 0;
  }

  .contact-link {
    display: inline-grid;
    grid-template-columns: 32px minmax(0, auto);
    align-items: center;
    gap: 12px;
    min-height: 32px;
    font-size: 1.05rem;
    line-height: 1.2;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: color 160ms ease;
  }

  .contact-link:hover,
  .contact-link:focus-visible {
    color: var(--color-deep-blue);
  }

  .contact-item {
    display: inline-grid;
    grid-template-columns: 32px minmax(0, auto);
    align-items: center;
    gap: 12px;
    min-height: 32px;
    color: #444;
    font-size: 1.05rem;
    line-height: 1.2;
  }

  .contact-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 32px;
    height: 32px;
    border: 1px solid #e4e4e4;
    border-radius: 50%;
    color: #666;
    transition:
      border-color 160ms ease,
      color 160ms ease;
  }

  .contact-link:hover .contact-icon,
  .contact-link:focus-visible .contact-icon {
    border-color: var(--color-deep-blue);
    color: var(--color-deep-blue);
  }

  .contact-icon svg {
    display: block;
    flex: 0 0 auto;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mixes {
    padding: 12px 0 0;
  }

  .service-area {
    padding: 20px 0 36px;
    border-top: 1px solid #eaeaea;
  }

  .service-area p {
    max-width: 760px;
    margin: 0;
    color: #444;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .mix-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(198px, 0.9fr));
    gap: 14px;
  }

  .mix-card {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px solid #eaeaea;
    border-radius: 8px;
    background: #f7f7f7;
  }

  .mix-card iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 720px) {
    .page {
      width: min(100% - 24px, 960px);
      padding: 12px 0 40px;
    }

    .hero {
      padding: 12px 0 32px;
    }

    .content {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-top: 32px;
    }

    .button {
      width: 100%;
    }
  }
</style>
