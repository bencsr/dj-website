    <dialog class="lightbox" aria-label="Képgaléria">
      <div class="lightbox-content">
        <img class="lightbox-image" src="" alt="" />
        <button class="lightbox-close" type="button" aria-label="Kép bezárása">
          <span aria-hidden="true">&times;</span>
        </button>
        <button class="lightbox-nav lightbox-previous" type="button" aria-label="Előző kép">
          <svg aria-hidden="true" width="18" height="28" viewBox="0 0 18 28" fill="none">
            <path d="M15 3 4 14l11 11" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <button class="lightbox-nav lightbox-next" type="button" aria-label="Következő kép">
          <svg aria-hidden="true" width="18" height="28" viewBox="0 0 18 28" fill="none">
            <path d="m3 3 11 11L3 25" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </dialog>

    <script>
      const galleryLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>(".service-thumbnail"),
      );
      const lightbox = document.querySelector<HTMLDialogElement>(".lightbox");
      const lightboxImage = document.querySelector<HTMLImageElement>(".lightbox-image");
      const closeButton = document.querySelector<HTMLButtonElement>(".lightbox-close");
      const previousButton = document.querySelector<HTMLButtonElement>(".lightbox-previous");
      const nextButton = document.querySelector<HTMLButtonElement>(".lightbox-next");
      let currentImageIndex = 0;

      const showImage = (index: number) => {
        if (!lightboxImage || galleryLinks.length === 0) return;

        currentImageIndex = (index + galleryLinks.length) % galleryLinks.length;
        const link = galleryLinks[currentImageIndex];
        const thumbnail = link.querySelector("img");

        lightboxImage.src = link.href;
        lightboxImage.alt = thumbnail?.alt ?? "Galériakép";
      };

      galleryLinks.forEach((link, index) => {
        link.addEventListener("click", (event) => {
          if (!lightbox || !lightboxImage) return;

          event.preventDefault();
          showImage(index);
          lightbox.showModal();
          document.body.classList.add("lightbox-open");
        });
      });

      closeButton?.addEventListener("click", () => lightbox?.close());
      previousButton?.addEventListener("click", () => showImage(currentImageIndex - 1));
      nextButton?.addEventListener("click", () => showImage(currentImageIndex + 1));

      lightbox?.addEventListener("click", (event) => {
        if (event.target === lightbox) lightbox.close();
      });

      lightbox?.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") showImage(currentImageIndex - 1);
        if (event.key === "ArrowRight") showImage(currentImageIndex + 1);
      });

      lightbox?.addEventListener("close", () => {
        document.body.classList.remove("lightbox-open");
        if (lightboxImage) lightboxImage.src = "";
      });
    </script>
  </body>
</html>

<style>
  :root {
    --color-deep-blue: #123a63;

    color: #111;
    background: #fff;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #fff;
    color: #111;
  }

  body.lightbox-open {
    overflow: hidden;
  }

  a {
    color: inherit;
  }

  .page {
    width: min(100% - 32px, 960px);
    margin: 0 auto;
    padding: 16px 0 56px;
  }

  .hero {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 16px 0 36px;
    border-bottom: 1px solid #eaeaea;
  }

  .hero-heading {
    display: grid;
    grid-template-columns: auto max-content;
    grid-template-rows: auto 1fr;
    align-items: start;
    justify-content: start;
    column-gap: 28px;
    width: 100%;
  }

  .brand-mark {
    display: block;
    grid-row: 1 / 3;
    flex: 0 0 auto;
  }

  .eyebrow {
    margin: 0 0 20px;
    color: #666;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--color-deep-blue);
    font-size: clamp(0.82rem, 4vw, 2.65rem);
    line-height: 1;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }

  .lead {
    align-self: end;
    justify-self: end;
    margin: 0;
    font-size: clamp(1rem, 2vw, 1.3rem);
    line-height: 1.45;
    color: #333;
    text-align: right;
  }

  .tagline {
    margin: 22px 0 0;
    color: var(--color-deep-blue);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 160ms ease,
      background 160ms ease,
      border-color 160ms ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .primary {
    background: #111;
    color: #fff;
  }

  .secondary {
    border: 1px solid #d8d8d8;
    color: #111;
  }

  .secondary:hover {
    border-color: #111;
  }

  h2 {
    margin: 0 0 8px;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .service-card p,
  .contact-section p {
    margin: 0;
    color: #444;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .service-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 28px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .hero + .service-card {
    margin-top: 36px;
  }

  .service-card + .service-card {
    margin-top: 32px;
  }

  .service-thumbnails {
    display: grid;
    grid-column: 2;
    grid-row: 1;
    grid-auto-flow: column;
    grid-auto-columns: 112px;
    justify-content: end;
    gap: 12px;
  }

  .service-thumbnail {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid #dedede;
    border-radius: 8px;
    background: #f7f7f7;
    color: #888;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    cursor: zoom-in;
    transition:
      border-color 160ms ease,
      transform 160ms ease;
  }

  .service-thumbnail:hover,
  .service-thumbnail:focus-visible {
    border-color: #999;
    transform: translateY(-2px);
  }

  .service-thumbnail img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .service-thumbnail-portrait {
    object-position: center 42%;
  }

  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100vh;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: visible;
    border: 0;
    background: transparent;
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 82%);
  }

  .lightbox-content {
    position: relative;
    display: grid;
    place-items: center;
  }

  .lightbox-image {
    display: block;
    width: auto;
    max-width: calc(100vw - 96px);
    height: auto;
    max-height: calc(100vh - 64px);
    border-radius: 6px;
    box-shadow: 0 16px 64px rgb(0 0 0 / 45%);
  }

  .lightbox-close,
  .lightbox-nav {
    position: absolute;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(0 0 0 / 58%);
    color: #fff;
    cursor: pointer;
    transition: background 160ms ease;
  }

  .lightbox-close:hover,
  .lightbox-close:focus-visible,
  .lightbox-nav:hover,
  .lightbox-nav:focus-visible {
    background: rgb(0 0 0 / 85%);
  }

  .lightbox-close {
    top: 10px;
    right: 10px;
    font-size: 2rem;
    line-height: 1;
  }

  .lightbox-nav {
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-nav svg {
    display: block;
  }

  .lightbox-previous {
    left: 10px;
  }

  .lightbox-next {
    right: 10px;
  }

  .service-copy {
    grid-column: 1;
    grid-row: 1;
  }

  .contact-section {
    padding: 24px 0;
  }

  .contact {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
  }

  .contact-section .contact-intro {
    margin: 0 0 20px;
    color: #444;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .contact li {
    margin: 0;
  }

  .contact-link {
    display: inline-grid;
    grid-template-columns: 32px minmax(0, auto);
    align-items: center;
    gap: 12px;
    min-height: 32px;
    font-size: 1.05rem;
    line-height: 1.2;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: color 160ms ease;
  }

  .contact-link:hover,
  .contact-link:focus-visible {
    color: var(--color-deep-blue);
  }

  .contact-item {
    display: inline-grid;
    grid-template-columns: 32px minmax(0, auto);
    align-items: center;
    gap: 12px;
    min-height: 32px;
    color: #444;
    font-size: 1.05rem;
    line-height: 1.2;
  }

  .contact-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 32px;
    height: 32px;
    border: 1px solid #e4e4e4;
    border-radius: 50%;
    color: #666;
    transition:
      border-color 160ms ease,
      color 160ms ease;
  }

  .contact-link:hover .contact-icon,
  .contact-link:focus-visible .contact-icon {
    border-color: var(--color-deep-blue);
    color: var(--color-deep-blue);
  }

  .contact-icon svg {
    display: block;
    flex: 0 0 auto;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mixes {
    padding: 12px 0 0;
  }

  .mix-intro {
    margin: 0 0 20px;
    color: #444;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .service-area {
    padding: 20px 0 36px;
    border-top: 1px solid #eaeaea;
  }

  .service-area p {
    margin: 0;
    color: #444;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .mix-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(198px, 0.9fr));
    gap: 14px;
  }

  .mix-card {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px solid #eaeaea;
    border-radius: 8px;
    background: #f7f7f7;
  }

  .mix-card iframe {
    display: block;
    width: 100%;
