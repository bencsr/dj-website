---
const name = "DJ Bencs";
const email = "bencsrr@gmail.com";
const facebook = "https://www.facebook.com/bencsr/";
const youtube = "https://www.youtube.com/@bencsr";
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{name} | DJ szolgáltatás rendezvényekre</title>
    <meta
      name="description"
      content="DJ szolgáltatás esküvőkre, céges rendezvényekre, születésnapokra és privát eseményekre."
    />
  </head>

  <body>
    <main class="page">
      <section class="hero">
        <p class="eyebrow">Esküvő • Céges rendezvény • Privát buli</p>

        <h1>{name}</h1>

        <p class="lead">
          Letisztult, megbízható DJ szolgáltatás rendezvényekre — jó hangulattal,
          igényes zenei válogatással és profi hozzáállással.
        </p>

        <div class="actions">
          <a class="button primary" href={`mailto:${email}`}>Ajánlatkérés</a>
          <a class="button secondary" href={youtube} target="_blank" rel="noopener">
            Mixek YouTube-on
          </a>
        </div>
      </section>

      <section class="content">
        <div>
          <h2>Szolgáltatások</h2>
          <p>
            DJ fellépés esküvőkre, céges rendezvényekre, születésnapokra és
            kisebb privát eseményekre. A zenei irányt mindig az eseményhez és a
            közönséghez igazítom.
          </p>
        </div>

        <div>
          <h2>Kapcsolat</h2>
          <ul class="contact">
            <li>
              <span>Email</span>
              <a href={`mailto:${email}`}>{email}</a>
            </li>
            <li>
              <span>Facebook</span>
              <a href={facebook} target="_blank" rel="noopener">facebook.com/bencsr</a>
            </li>
            <li>
              <span>YouTube</span>
              <a href={youtube} target="_blank" rel="noopener">youtube.com/@bencsr</a>
            </li>
          </ul>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color: #111;
    background: #fff;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #fff;
    color: #111;
  }

  a {
    color: inherit;
  }

  .page {
    width: min(100% - 32px, 960px);
    margin: 0 auto;
    padding: 16px 0 56px;
  }

  .hero {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 16px 0 56px;
    border-bottom: 1px solid #eaeaea;
  }

  .eyebrow {
    margin: 0 0 20px;
    color: #666;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 10vw, 7rem);
    line-height: 0.92;
    letter-spacing: -0.07em;
  }

  .lead {
    max-width: 680px;
    margin: 28px 0 0;
    font-size: clamp(1.15rem, 2.5vw, 1.6rem);
    line-height: 1.45;
    color: #333;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 160ms ease,
      background 160ms ease,
      border-color 160ms ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .primary {
    background: #111;
    color: #fff;
  }

  .secondary {
    border: 1px solid #d8d8d8;
    color: #111;
  }

  .secondary:hover {
    border-color: #111;
  }

  .content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    padding: 56px 0 24px;
  }

  h2 {
    margin: 0 0 16px;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .content p {
    margin: 0;
    color: #444;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .contact {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 18px;
  }

  .contact li {
    display: grid;
    gap: 4px;
  }

  .contact span {
    color: #777;
    font-size: 0.9rem;
  }

  .contact a {
    font-size: 1.05rem;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  @media (max-width: 720px) {
    .page {
      width: min(100% - 24px, 960px);
      padding: 12px 0 40px;
    }

    .hero {
      padding: 12px 0 44px;
    }

    .content {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-top: 40px;
    }

    .button {
      width: 100%;
    }
  }
</style>
